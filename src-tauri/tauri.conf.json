{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Suisai",
  "version": "0.1.0",
  "identifier": "com.marcoskwkm.suisai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Suisai",
        "width": 1400,
        "height": 900,
        "minWidth": 640,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "GitHub-style diff viewer for git",
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "mainBinaryName": "suisai"
}